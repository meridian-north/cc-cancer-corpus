!/FOR_A_DOCTOR.md
!/FOR_A_RESEARCHER.md
!/FOR_A_STRANGER.md
!/GEMINI_FEEDSTOCK_SOURCING_PROMPT.md
!/"GEMINI_FEEDSTOCK_SOURCING_PROMPT_v2 copy.md"
!/GEMINI_FEEDSTOCK_SOURCING_PROMPT_v2.md
!/GROK_CROSSCHECK_AND_SOURCE_PROMPT.md
!/IMPPAT2_INGESTION.md
!/MECHANISM_BRIDGE_electron_transport.md
!/MECHANISM_BRIDGE_perfusion.md
!/MOA_compendium_seed.md
